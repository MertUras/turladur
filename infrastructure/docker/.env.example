# Local Docker services — copy relevant values into apps/api/.env

# PostgreSQL (host port 5433)
DATABASE_URL=postgresql://tourtech:tourtech@localhost:5433/tourtech?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# MinIO / S3
