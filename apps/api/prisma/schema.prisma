// ─── booking ────────────────────────────────────────────

enum BookingStatus {
  PENDING
  PENDING_PAYMENT
  CONFIRMED
  COMPLETED
  CANCELLED
  SUSPENDED
  PAYMENT_FAILED
  EXPIRED

  @@schema("booking")
}

enum ReservationPaymentStatus {
  UNPAID
  /// Expand uyumu — hedef dokümanda yok; yeni yazımlarda kullanılmaz.
  PARTIALLY_PAID
  PAID
  REFUNDED

  @@schema("booking")
}

enum PaymentMethod {
  CARD
  BANK_TRANSFER
  WALLET
  OTHER

  @@schema("booking")
}

/// Tur rezervasyonu — hold 10 dk (PENDING_PAYMENT). Otel satışı yok.
model Reservation {
  id                    String                   @id @default(cuid())
  bookingNumber         String                   @unique @db.VarChar(20)
  userId                String
  tourId                String?
  tourDateId            String?
  experienceId          String?
  activityDateId        String?
  agencyId               String
  status                 BookingStatus            @default(PENDING_PAYMENT)
  paymentStatus         ReservationPaymentStatus @default(UNPAID)
  paymentMethod         PaymentMethod?
  currency              String                   @default("TRY") @db.VarChar(3)
  adults                Int                      @default(1)
  children              Int                      @default(0)
  totalAmount           Decimal                  @db.Decimal(10, 2)
  boardingPickupPointId String?
  boardingPickupPoint   TourPickupPoint?         @relation(fields: [boardingPickupPointId], references: [id])
  contactEmail          String
  contactPhone          String?
  /// Legacy JSON; kaynak: ReservationGuest.
  guests                Json?
  specialRequests       String?                  @db.Text
  metadata              Json?
  startDate             DateTime?
  endDate               DateTime?
  holdExpiresAt         DateTime?
  heldPartySize         Int?
  cancelledAt           DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  createdBy             String?
  updatedBy             String?
  deletedBy             String?
  deletedAt             DateTime?

  reservationGuests ReservationGuest[]
  reservationExtras ReservationExtra[]
  voucher           Voucher?
  seatAssignments   SeatAssignment[]
  agencyEarnings    AgencyEarning[]

  @@index([userId])
  @@index([tourId])
  @@index([tourDateId])
  @@index([experienceId])
  @@index([activityDateId])
  @@index([agencyId])
  @@index([status])
  @@index([status, holdExpiresAt])
  @@index([agencyId, status, createdAt])
  @@index([deletedAt])
  @@schema("booking")
}

model ReservationGuest {
  id             String      @id @default(cuid())
  reservationId  String
  reservation    Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  fullName       String      @db.VarChar(200)
  identityNumber String
  birthDate      DateTime?   @db.Date
  isChild        Boolean     @default(false)
  sortOrder      Int         @default(0)
  createdBy  String?
  updatedBy  String?
  deletedBy  String?
  deletedAt      DateTime?

  seatAssignments SeatAssignment[]

  @@index([reservationId])
  @@schema("booking")
}

model ReservationExtra {
  id            String      @id @default(cuid())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  tourExtraId   String
  tourExtra     TourExtra   @relation(fields: [tourExtraId], references: [id])
  quantity      Int
  unitPrice     Decimal     @db.Decimal(10, 2)
  currency      String      @db.VarChar(3)
  createdAt     DateTime    @default(now())
  createdBy  String?
  updatedBy  String?
  deletedBy  String?
  deletedAt     DateTime?

  @@unique([reservationId, tourExtraId])
  @@index([reservationId])
  @@index([tourExtraId])
  @@schema("booking")
}

model Voucher {
  id            String      @id @default(cuid())
  reservationId String      @unique
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  code          String      @unique @db.VarChar(40)
  qrPayload     String?     @db.Text
  issuedAt      DateTime    @default(now())
  createdBy  String?
  updatedBy  String?
  deletedBy  String?
  deletedAt     DateTime?

  @@schema("booking")
}

/// Yolcu → koltuk (ödeme sonrası / kalkış öncesi; müşteri checkout’ta seçmez).
model SeatAssignment {
  id                      String           @id @default(cuid())
  tourDateId              String
  tourDate                TourDate         @relation(fields: [tourDateId], references: [id], onDelete: Cascade)
  seatCode                String           @db.VarChar(16)
  reservationGuestId      String
  reservationGuest        ReservationGuest @relation(fields: [reservationGuestId], references: [id], onDelete: Cascade)
  reservationId           String
  reservation             Reservation      @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  assignedByAgencyStaffId String?
  assignedByAgencyStaff   AgencyStaff?     @relation(fields: [assignedByAgencyStaffId], references: [id], onDelete: SetNull)
  assignedByAgencyId      String?
  assignedByAgency        Agency?          @relation(fields: [assignedByAgencyId], references: [id], onDelete: SetNull)
  assignedAt              DateTime         @default(now())
  /// MANUAL | AUTO_FIFO
  source                  String           @db.VarChar(20)
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  createdBy  String?
  updatedBy  String?
  deletedBy  String?
  deletedAt               DateTime?

  /// Aktif unique'ler partial migrate SQL: (tourDateId,seatCode), reservationGuestId.
  @@index([tourDateId, assignedAt])
  @@index([reservationId])
  @@index([reservationGuestId])
  @@index([deletedAt])
  @@schema("booking")
}

// ─── payment ────────────────────────────────────────────

enum PaymentStatus {
  PENDING
  AWAITING_3DS
  SUCCESS
  FAILED
  REFUNDED

  @@schema("payment")
}

enum PaymentProvider {
  IYZICO
  MOCK

  @@schema("payment")
}

enum InvoiceProvider {
  MOCK
  PARASUT
  LOGO
  UYUMSOFT
  OTHER

  @@schema("payment")
}

enum InvoiceStatus {
  DRAFT
  QUEUED
  ISSUED
  FAILED
  CANCELLED

  @@schema("payment")
}

enum RefundStatus {
  PENDING
  SUCCESS
  FAILED

  @@schema("payment")
}

model PaymentTransaction {
  id                String          @id @default(cuid())
  reservationId     String
  amount            Decimal         @db.Decimal(10, 2)
  currency          String          @default("TRY") @db.VarChar(3)
  status            PaymentStatus   @default(PENDING)
  method            PaymentMethod   @default(CARD)
  provider          PaymentProvider @default(IYZICO)
  conversationId    String          @unique
  providerPaymentId String?
  errorMessage      String?
  rawResponse       Json?
  paidAt            DateTime?
  refundedAt        DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  createdBy  String?
  updatedBy  String?
  deletedBy  String?
  deletedAt         DateTime?

  invoices Invoice[]
  refunds  Refund[]

  @@index([reservationId])
  @@index([status])
  @@schema("payment")
}

model Refund {
  id                   String             @id @default(cuid())
  paymentTransactionId String
  paymentTransaction   PaymentTransaction @relation(fields: [paymentTransactionId], references: [id])
  reservationId        String
  amount               Decimal            @db.Decimal(10, 2)
  currency             String             @db.VarChar(3)
  status               RefundStatus       @default(PENDING)
  reason               String?            @db.Text
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  createdBy  String?
  updatedBy  String?
  deletedBy  String?
  deletedAt            DateTime?

  @@index([reservationId])
  @@schema("payment")
}

model Invoice {
  id                   String              @id @default(cuid())
  reservationId        String
  paymentTransactionId String?
  paymentTransaction   PaymentTransaction? @relation(fields: [paymentTransactionId], references: [id])
  userId               String
  agencyId             String
  provider             InvoiceProvider     @default(MOCK)
  status               InvoiceStatus       @default(QUEUED)
  externalId           String?
  invoiceNumber        String?
  amount               Decimal             @db.Decimal(12, 2)
  currency             String              @db.VarChar(3)
  buyerSnapshot        Json
  sellerSnapshot       Json
  linesSnapshot        Json
  pdfUrl               String?
  rawResponse          Json?
  issuedAt             DateTime?
  lastError            String?             @db.Text
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  createdBy  String?
  updatedBy  String?
  deletedBy  String?
  deletedAt            DateTime?

  @@index([reservationId])
  @@index([status, createdAt])
  @@index([provider])
  @@index([externalId])
  @@schema("payment")
}

/// Acenteye özel platform komisyon oranı (örn. 10.00 = %10 platform payı).
model AgencyCommissionRate {
  id            String    @id @default(cuid())
  agencyId      String
  agency        Agency    @relation(fields: [agencyId], references: [id])
  ratePercent   Decimal   @db.Decimal(5, 2)
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdBy  String?
  updatedBy  String?
  deletedBy  String?
  deletedAt     DateTime?

  @@index([agencyId, effectiveFrom])
  @@index([deletedAt])
  @@schema("payment")
}

/// AgencyEarning = gross − platform komisyonu (acente neti).
model AgencyEarning {
  id                    String        @id @default(cuid())
  agencyId              String
  agency                Agency        @relation(fields: [agencyId], references: [id])
  reservationId         String
  reservation           Reservation   @relation(fields: [reservationId], references: [id])
  /// Acente net tutar.
  amount                Decimal       @db.Decimal(10, 2)
  grossAmount           Decimal       @db.Decimal(10, 2)
  commissionAmount      Decimal       @db.Decimal(10, 2)
  commissionRatePercent Decimal       @db.Decimal(5, 2)
  currency              String        @db.VarChar(3)
  /// ACCRUED | PAYABLE | PAID
  status                String        @db.VarChar(40)
  payoutId              String?
  payout                AgencyPayout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  createdAt             DateTime      @default(now())
  createdBy  String?
  updatedBy  String?
  deletedBy  String?
  deletedAt             DateTime?

  @@unique([reservationId])
  @@index([agencyId, status])
  @@index([payoutId])
  @@index([deletedAt])
  @@schema("payment")
}

model AgencyPayout {
  id        String    @id @default(cuid())
  agencyId  String
  agency    Agency    @relation(fields: [agencyId], references: [id])
  amount    Decimal   @db.Decimal(10, 2)
  currency  String    @db.VarChar(3)
  /// PENDING | PAID | FAILED
  status    String    @db.VarChar(40)
  paidAt    DateTime?
  note      String?   @db.Text
  createdAt DateTime  @default(now())
  createdBy  String?
  updatedBy  String?
  deletedBy  String?
  deletedAt DateTime?

  earnings AgencyEarning[]

  @@index([agencyId, status])
  @@index([deletedAt])
  @@schema("payment")
}

// ─── review ─────────────────────────────────────────────

enum ReviewTargetType {
  TOUR
  EXPERIENCE
  HOTEL
  PARTNER
  AGENCY
  GUIDE
  BUS_COMPANY

  @@schema("review")
}

/// Ürün / partner değerlendirmesi — expand: agencyId + kategori alanları; Outbox → TourMetrics.
model Review {
  id                    String           @id @default(cuid())
  targetType            ReviewTargetType @default(TOUR)
  tourId                String?
  experienceId          String?
  hotelId               String?
  reservationId         String           @unique
  userId                String
  agencyId                String
  guideId               String?
  busCompanyId          String?
  rating                Int
  comment               String?          @db.Text
  photoUrls             String[]         @default([])
  guideRating           Int?
  operatorRating        Int?
  routeRating           Int?
  foodRating            Int?
  hotelRating           Int?
  transportRating       Int?
  accommodationRating   Int?
  guideFeedback         String?          @db.Text
  transportFeedback     String?          @db.Text
  accommodationFeedback String?          @db.Text
  /// Expand: partnerReply hâlâ; hedef agencyReply.
  partnerReply          String?          @db.Text
  partnerRepliedAt      DateTime?
  agencyReply           String?          @db.Text
  agencyRepliedAt       DateTime?
  version               Int              @default(1)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  createdBy             String?
  updatedBy             String?
  deletedBy             String?
  deletedAt             DateTime?

  @@index([tourId])
  @@index([experienceId])
  @@index([hotelId])
  @@index([agencyId])
  @@index([guideId])
  @@index([busCompanyId])
  @@index([userId])
  @@index([targetType])
  @@index([rating])
  @@index([guideRating])
  @@index([transportRating])
  @@index([accommodationRating])
  @@index([tourId, deletedAt])
  @@index([deletedAt])
  @@schema("review")
}

/// Review OutboxWorker read-model → Tour.averageRating / reviewCount mirror.
model TourMetrics {
  id                         String    @id @default(cuid())
  tourId                     String    @unique
  tour                       Tour      @relation(fields: [tourId], references: [id], onDelete: Cascade)
  reviewCount                Int       @default(0)
  averageRating              Decimal   @default(0) @db.Decimal(3, 2)
  averageGuideRating         Decimal   @default(0) @db.Decimal(3, 2)
  averageTransportRating     Decimal   @default(0) @db.Decimal(3, 2)
  averageAccommodationRating Decimal   @default(0) @db.Decimal(3, 2)
  averageOperatorRating      Decimal?  @db.Decimal(3, 2)
  averageRouteRating         Decimal?  @db.Decimal(3, 2)
  averageFoodRating          Decimal?  @db.Decimal(3, 2)
  lastReviewAt               DateTime?
  updatedAt                  DateTime  @updatedAt
  createdBy  String?
  updatedBy  String?
  deletedBy  String?
  deletedAt                  DateTime?

  @@index([averageRating])
  @@index([averageGuideRating])
  @@index([averageTransportRating])
  @@index([averageAccommodationRating])
  @@index([reviewCount])
  @@index([averageGuideRating, averageTransportRating, averageAccommodationRating])
  @@index([deletedAt])
  @@schema("review")
}

