generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["identity", "catalog", "booking", "payment", "review", "notification", "analytics", "content", "outbox", "promotion"]
}

// ─── identity ───────────────────────────────────────────

enum UserRole {
  CUSTOMER
  PARTNER
  PARTNER_STAFF
  ADMIN
  SUPER_ADMIN
  /// Hedef platform rolleri (expand — eski ADMIN/SUPER_ADMIN ile birlikte).
  PLATFORM_ADMIN
  PLATFORM_SUPER_ADMIN

  @@schema("identity")
}

model User {
  id                String         @id @default(cuid())
  /// Soft-delete: partial unique migrate SQL (User_email_active_key).
  email             String
  passwordHash      String
  firstName         String?
  lastName          String?
  phone             String?
  /// TC Kimlik No (11 hane) — fatura / rezervasyon misafir bilgisi.
  identityNumber    String?
  birthDate         DateTime?      @db.Date
  /// Kişisel adres (tek satır / serbest metin).
  address           String?
  /// Fatura adresi alanları.
  billingLine1      String?
  billingLine2      String?
  billingCity       String?
  billingState      String?
  billingPostalCode String?
  billingCountry    String?        @default("Türkiye")
  role              UserRole       @default(CUSTOMER)
  isActive          Boolean        @default(true)
  /// Staff izinleri (AgencyStaff.permissions tercih edilir).
  permissions       Json?
  refreshTokens     RefreshToken[]
  favorites         Favorite[]
  couponUsages      CouponUsage[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  createdBy  String?
  updatedBy  String?
  deletedBy  String?
  deletedAt         DateTime?

  @@index([role])
  @@index([email])
  @@index([deletedAt])
  @@schema("identity")
}

/// Kullanıcı favori tur/deneyim (tourId XOR experienceId).
model Favorite {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tourId       String?
  tour         Tour?       @relation(fields: [tourId], references: [id], onDelete: Cascade)
  experienceId String?
  experience   Experience? @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())
  createdBy  String?
  updatedBy  String?
  deletedBy  String?
  deletedAt    DateTime?

  /// Aktif unique: partial migrate SQL (userId,tourId) / (userId,experienceId).
  @@index([userId])
  @@index([tourId])
  @@index([experienceId])
  @@index([deletedAt])
  @@schema("identity")
}

/// Email OTP — checkout, kayıt, şifre sıfırlama (SMS sonraki aşama).
enum OtpPurpose {
  CHECKOUT
  REGISTER
  PASSWORD_RESET

  @@schema("identity")
}

model EmailOtp {
  id         String     @id @default(cuid())
  email      String
  purpose    OtpPurpose
  codeHash   String
  attempts   Int        @default(0)
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([email, purpose])
  @@index([expiresAt])
  @@schema("identity")
}




// ─── identity: marketplace Agency (P0-A hard contract) ───

enum AgencyStaffRole {
  AGENCY_OWNER
  AGENCY_ADMIN
  AGENCY_STAFF

  @@schema("identity")
}

enum AgencyStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED

  @@schema("identity")
}

enum AgencyCapability {
  TOURS

  @@schema("identity")
}

enum SellerTier {
  BRONZE
  SILVER
  GOLD

  @@schema("identity")
}

enum BusCompanyStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED

  @@schema("identity")
}

enum GuideStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED

  @@schema("identity")
}

enum TursabVerificationStatus {
  NOT_SUBMITTED
  PENDING
  VERIFIED
  MISMATCH
  NOT_FOUND
  SUSPENDED
  ERROR

  @@schema("identity")
}

/// Tur otobüsü N+1 standartları (Vehicle.seatLayoutKind). BusSeatLayout Faz 5.
enum BusLayoutKind {
  BUS_19_PLUS_1
  BUS_31_PLUS_1
  BUS_35_PLUS_1
  BUS_46_PLUS_1
  BUS_50_PLUS_1

  @@schema("identity")
}

/// Tüzel satıcı acente — giriş YOK. Sahip = AgencyStaff AGENCY_OWNER.
/// Unique (taxNumber, contactEmail, tursabBelgeNo): partial index migrate SQL.
model Agency {
  id                       String                   @id @default(cuid())
  companyName              String
  taxNumber                String
  legalTitle               String
  address                  String
  city                     String?
  country                  String?                  @default("Türkiye")
  contactEmail             String
  contactPhone             String?
  status                   AgencyStatus             @default(PENDING)
  capabilities             AgencyCapability[]       @default([TOURS])
  sellerTier               SellerTier               @default(BRONZE)
  sellerScore              Decimal?                 @db.Decimal(5, 2)
  sellerTierCalculatedAt   DateTime?
  website                  String?
  logo                     String?
  license                  String?
  verifiedAt               DateTime?
  tursabBelgeNo            String?
  tursabUnvan              String?
  tursabGroup              String?
  tursabCity               String?
  tursabVerificationStatus TursabVerificationStatus @default(NOT_SUBMITTED)
  tursabVerifiedAt         DateTime?
  tursabLastCheckedAt      DateTime?
  tursabExpiresAt          DateTime?
  tursabRawSnapshot        Json?
  averageRating            Decimal                  @default(0) @db.Decimal(3, 2)
  reviewCount              Int                      @default(0)
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  createdBy  String?
  updatedBy  String?
  deletedBy  String?
  deletedAt                DateTime?

  staff               AgencyStaff[]
  tursabLogs          TursabVerificationLog[]
  bankInfo            AgencyBankInfo?
  tours               Tour[]
  hotels              Hotel[]
  tourDateAssignments TourDateAssignment[]
  busSeatLayouts      BusSeatLayout[]
  seatAssignments     SeatAssignment[]
  commissionRates     AgencyCommissionRate[]
  earnings            AgencyEarning[]
  payouts             AgencyPayout[]
  experiences         Experience[]

  @@index([status])
  @@index([taxNumber])
  @@index([sellerTier])
  @@index([deletedAt])
  @@index([contactEmail])
  @@schema("identity")
}

/// Giriş yapan gerçek kişi (sahip dahil). Partial unique: (agencyId, email) WHERE deletedAt IS NULL.
model AgencyStaff {
  id           String          @id @default(cuid())
  agencyId     String
  agency       Agency          @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  name         String
  email        String
  passwordHash String
  role         AgencyStaffRole
  permissions  Json            @default("{}")
  status       String          @default("ACTIVE") @db.VarChar(40)
  lastLoginAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  createdBy  String?
  updatedBy  String?
  deletedBy  String?
  deletedAt    DateTime?

  refreshTokens       RefreshToken[]
  tourDateAssignments TourDateAssignment[]
  seatAssignments     SeatAssignment[]

  @@index([agencyId])
  @@index([email])
  @@index([deletedAt])
  @@schema("identity")
}

model BusCompany {
  id            String           @id @default(cuid())
  companyName   String
  taxNumber     String?
  contactEmail  String
  passwordHash  String
  contactPhone  String?
  status        BusCompanyStatus @default(PENDING)
  address       String?
  city          String?
  country       String?
  website       String?
  logo          String?
  licenseNumber String?
  vehicleCount  Int?
  notes         String?          @db.Text
  verifiedAt    DateTime?
  averageRating Decimal?         @default(0) @db.Decimal(3, 2)
  reviewCount   Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  createdBy     String?
  updatedBy     String?
  deletedBy     String?
  deletedAt     DateTime?

  vehicles            Vehicle[]
  refreshTokens       RefreshToken[]
  tourDateAssignments TourDateAssignment[]
  assignedTourDates   TourDate[]

  @@index([status])
  @@index([deletedAt])
  @@index([contactEmail])
  @@schema("identity")
}

model Guide {
  id              String      @id @default(cuid())
  identityNumber  String
  firstName       String
  lastName        String
  email           String
  passwordHash    String
  phone           String?
  birthDate       DateTime?   @db.Date
  status          GuideStatus @default(PENDING)
  languages       String[]    @default([])
  oda             String?
  sicilNo         String?
  ruhsatNo        String?
  ruhsatExpiresAt DateTime?
  licenseNumber   String?
  bio             String?     @db.Text
  photoUrl        String?
  city            String?
  verifiedAt      DateTime?
  averageRating   Decimal?    @default(0) @db.Decimal(3, 2)
  reviewCount     Int         @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  createdBy  String?
  updatedBy  String?
  deletedBy  String?
  deletedAt       DateTime?

  availability        GuideAvailability[]
  refreshTokens       RefreshToken[]
  tourDateAssignments TourDateAssignment[]
  assignedTourDates   TourDate[]

  @@index([status])
  @@index([city])
  @@index([sicilNo])
  @@index([deletedAt])
  @@index([email])
  @@index([identityNumber])
  @@schema("identity")
}

model Vehicle {
  id             String        @id @default(cuid())
  busCompanyId   String
  busCompany     BusCompany    @relation(fields: [busCompanyId], references: [id], onDelete: Cascade)
  plateNumber    String
  modelYear      Int?
  seatLayoutKind BusLayoutKind
  capacity       Int
  isActive       Boolean       @default(true)
  notes          String?       @db.Text
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  createdBy  String?
  updatedBy  String?
  deletedBy  String?
  deletedAt      DateTime?

  availability      VehicleAvailability[]
  assignedTourDates TourDate[]

  @@index([busCompanyId])
  @@index([seatLayoutKind])
  @@index([deletedAt])
  @@index([plateNumber])
  @@schema("identity")
}

model GuideAvailability {
  id          String    @id @default(cuid())
  guideId     String
  guide       Guide     @relation(fields: [guideId], references: [id], onDelete: Cascade)
  date        DateTime  @db.Date
  isAvailable Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy  String?
  updatedBy  String?
  deletedBy  String?
  deletedAt   DateTime?

  @@unique([guideId, date])
  @@index([guideId, date, isAvailable])
  @@schema("identity")
}

model VehicleAvailability {
  id          String    @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  date        DateTime  @db.Date
  isAvailable Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy  String?
  updatedBy  String?
  deletedBy  String?
  deletedAt   DateTime?

  @@unique([vehicleId, date])
  @@index([vehicleId, date, isAvailable])
  @@schema("identity")
}

model TursabVerificationLog {
  id              String                    @id @default(cuid())
  agencyId        String
  agency          Agency                    @relation(fields: [agencyId], references: [id])
  belgeNo         String                    @db.VarChar(32)
  trigger         String                    @db.VarChar(40)
  success         Boolean
  statusResult    TursabVerificationStatus?
  httpStatus      Int?
  requestId       String?
  errorMessage    String?                   @db.Text
  responseSummary Json?
  createdAt       DateTime                  @default(now())
  createdBy       String?

  @@index([agencyId, createdAt])
  @@index([belgeNo, createdAt])
  @@index([success, createdAt])
  @@schema("identity")
}

model AgencyBankInfo {
  id          String    @id @default(cuid())
  agencyId    String    @unique
  agency      Agency    @relation(fields: [agencyId], references: [id])
  iban        String    @db.VarChar(34)
  accountName String    @db.VarChar(200)
  bankName    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String?
  updatedBy   String?
  deletedBy   String?
  deletedAt   DateTime?

  @@schema("identity")
}

/// userId XOR agencyStaffId XOR busCompanyId XOR guideId — uygulama katmanı.
model RefreshToken {
  id                 String         @id @default(cuid())
  userId             String?
  user               User?          @relation(fields: [userId], references: [id])
  agencyStaffId      String?
  agencyStaff        AgencyStaff?   @relation(fields: [agencyStaffId], references: [id])
  busCompanyId       String?
  busCompany         BusCompany?    @relation(fields: [busCompanyId], references: [id])
  guideId            String?
  guide              Guide?         @relation(fields: [guideId], references: [id])
  tokenHash          String
  familyId           String?
  expiresAt          DateTime
  idleTimeoutMinutes Int?
  lastUsedAt         DateTime?
  revokedAt          DateTime?
  replacedById       String?
  replacedBy         RefreshToken?  @relation("RefreshTokenRotation", fields: [replacedById], references: [id])
  replaces           RefreshToken[] @relation("RefreshTokenRotation")
  createdAt          DateTime       @default(now())
  deletedAt          DateTime?

  @@index([userId])
  @@index([agencyStaffId])
  @@index([busCompanyId])
  @@index([guideId])
  @@index([expiresAt])
  @@index([familyId])
  @@index([tokenHash])
  @@schema("identity")
}

model IdempotencyKey {
  id             String    @id @default(cuid())
  key            String    @unique @db.VarChar(128)
  userId         String?
  agencyId       String?
  agencyStaffId  String?
  method         String    @db.VarChar(16)
  path           String    @db.VarChar(256)
  requestHash    String?
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime  @default(now())
  expiresAt      DateTime
  deletedAt      DateTime?

  @@index([expiresAt])
  @@index([userId, createdAt])
  @@schema("identity")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorType  String   @db.VarChar(40)
  actorId    String?
  action     String   @db.VarChar(80)
  entityType String   @db.VarChar(80)
  entityId   String?
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@schema("identity")
}

// ─── catalog ────────────────────────────────────────────

enum TourStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  ARCHIVED

  @@schema("catalog")
}

enum TourCategory {
  CULTURAL
  ADVENTURE
  GASTRONOMY
  NATURE
  CITY
  BEACH

  @@schema("catalog")
}

/// Rehber / otobüs atama yanıtı (TourDateAssignment).
enum AssignmentStatus {
  PENDING
  ACCEPTED
  REJECTED

  @@schema("catalog")
}

model Tour {
  id              String              @id @default(cuid())
  title           String              @db.VarChar(200)
  slug            String              @unique @db.VarChar(220)
  description     String              @db.Text
  coverUrl        String?
  galleryUrls     String[]            @default([])
  /// Legacy JSON bag — yeni opsiyoneller `TourExtra` tablosunda.
  extras          Json                @default("{}")
  price           Decimal             @db.Decimal(10, 2)
  currency        String              @default("TRY") @db.VarChar(3)
  category        TourCategory
  status          TourStatus          @default(DRAFT)
  durationDays    Int                 @default(1)
  stayKind        TourStayKind        @default(OVERNIGHT)
  destinationScope TourDestinationScope @default(DOMESTIC)
  departureCities String[]            @default([])
  childMaxAge     Int?
  minParticipants Int?
  /// Optimistic lock.
  version         Int                 @default(1)
  /// Legacy parity — öne çıkan turlar.
  featured        Boolean             @default(false)
  averageRating   Decimal             @default(0) @db.Decimal(3, 2)
  reviewCount     Int                 @default(0)
  agencyId         String
  agency           Agency       @relation(fields: [agencyId], references: [id])
  dates           TourDate[]
  departureRules  TourDepartureRule[]
  tourExtras      TourExtra[]
  accommodation   TourAccommodation?
  pickupPoints    TourPickupPoint[]
  tourTags        TourTag[]
  metrics         TourMetrics?
  favorites       Favorite[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  createdBy  String?
  updatedBy  String?
  deletedBy  String?
  deletedAt       DateTime?

  @@index([agencyId])
  @@index([category, status])
  @@index([slug])
  @@index([featured, status])
  @@index([stayKind, status])
  @@index([destinationScope, status])
  @@index([deletedAt])
  @@schema("catalog")
}

enum TourStayKind {
  DAY_TRIP
  OVERNIGHT

  @@schema("catalog")
}

enum TourDestinationScope {
  DOMESTIC
  INTERNATIONAL

  @@schema("catalog")
}

enum TagKind {
  DESTINATION
  TOUR_CATEGORY
  THEME
  GENERIC

  @@schema("catalog")
}

model Tag {
  id        String    @id @default(cuid())
  name      String    @db.VarChar(120)
  slug      String    @unique @db.VarChar(140)
  kind      TagKind   @default(GENERIC)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy  String?
  updatedBy  String?
  deletedBy  String?
  deletedAt DateTime?

  tourTags TourTag[]
  postTags PostTag[]

  @@index([kind, deletedAt])
  @@index([deletedAt])
  @@schema("catalog")
}

model TourTag {
  tourId String
  tour   Tour   @relation(fields: [tourId], references: [id], onDelete: Cascade)
  tagId  String
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([tourId, tagId])
  @@index([tagId])
  @@schema("catalog")
}

model TourDepartureRule {
  id                   String     @id @default(cuid())
  tourId               String
  tour                 Tour       @relation(fields: [tourId], references: [id], onDelete: Cascade)
  rangeStart           DateTime   @db.Date
  rangeEnd             DateTime   @db.Date
  weekdays             Int[]      @default([])
  defaultCapacity      Int
  defaultPriceOverride Decimal?   @db.Decimal(10, 2)
  ageRangeTemplate     Json?
  isActive             Boolean    @default(true)
  lastGeneratedAt      DateTime?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  createdBy            String?
  updatedBy            String?
  deletedBy            String?
  deletedAt            DateTime?
  generatedDates       TourDate[]

  @@index([tourId, isActive])
  @@index([deletedAt])
  @@schema("catalog")
}

model TourDate {
  id                String               @id @default(cuid())
  tourId            String
  tour              Tour                 @relation(fields: [tourId], references: [id])
  startDate         DateTime             @db.Date
  endDate           DateTime             @db.Date
  capacity          Int
  remainingCapacity Int
  priceOverride     Decimal?             @db.Decimal(10, 2)
  isActive          Boolean              @default(true)
  version           Int                  @default(1)
  departureRuleId   String?
  departureRule     TourDepartureRule?   @relation(fields: [departureRuleId], references: [id], onDelete: SetNull)
  /// Mirror — Assignment ACCEPTED sonrası.
  guideId           String?
  guide             Guide?               @relation(fields: [guideId], references: [id], onDelete: SetNull)
  busCompanyId      String?
  busCompany        BusCompany?          @relation(fields: [busCompanyId], references: [id], onDelete: SetNull)
  vehicleId         String?
  vehicle           Vehicle?             @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  busSeatLayoutId   String?
  busSeatLayout     BusSeatLayout?       @relation(fields: [busSeatLayoutId], references: [id], onDelete: SetNull)
  ageRanges         TourDateAgeRange[]
  assignments       TourDateAssignment[]
  seatAssignments   SeatAssignment[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  createdBy  String?
  updatedBy  String?
  deletedBy  String?
  deletedAt         DateTime?

  /// Doküman UNIQUE (tourId, startDate, endDate) — soft-delete için partial index migrate SQL.
  @@index([tourId, startDate, endDate])
  @@index([tourId, startDate])
  @@index([departureRuleId])
  @@index([guideId])
  @@index([busCompanyId])
  @@index([vehicleId])
  @@index([busSeatLayoutId])
  @@index([deletedAt])
  @@schema("catalog")
}

/// Tur otobüsü N+1 standart planı (sistem seed: 5 kind).
model BusSeatLayout {
  id             String        @id @default(cuid())
  kind           BusLayoutKind @unique
  agencyId       String?
  agency         Agency?       @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  name           String        @db.VarChar(120)
  passengerSeats Int
  crewSeats      Int           @default(1)
  rows           Int
  cols           Int
  layoutJson     Json
  isSystem       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  createdBy  String?
  updatedBy  String?
  deletedBy  String?
  deletedAt      DateTime?

  tourDates TourDate[]

  @@index([kind])
  @@index([agencyId])
  @@index([deletedAt])
  @@schema("catalog")
}

/// Acente teklif → rehber/otobüs PENDING → ACCEPTED/REJECTED → TourDate mirror.
model TourDateAssignment {
  id                     String           @id @default(cuid())
  tourDateId             String
  tourDate               TourDate         @relation(fields: [tourDateId], references: [id], onDelete: Cascade)
  /// GUIDE | BUS
  role                   String           @db.VarChar(16)
  guideId                String?
  guide                  Guide?           @relation(fields: [guideId], references: [id], onDelete: Cascade)
  busCompanyId           String?
  busCompany             BusCompany?      @relation(fields: [busCompanyId], references: [id], onDelete: Cascade)
  status                 AssignmentStatus @default(PENDING)
  invitedByAgencyId      String
  invitedByAgency        Agency           @relation(fields: [invitedByAgencyId], references: [id])
  invitedByAgencyStaffId String?
  invitedByAgencyStaff   AgencyStaff?     @relation(fields: [invitedByAgencyStaffId], references: [id], onDelete: SetNull)
  respondedAt            DateTime?
  note                   String?          @db.Text
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  createdBy  String?
  updatedBy  String?
  deletedBy  String?
  deletedAt              DateTime?

  /// Aktif PENDING|ACCEPTED role başına 1 — partial unique migrate SQL.
  @@index([tourDateId])
  @@index([guideId, status])
  @@index([busCompanyId, status])
  @@index([invitedByAgencyId])
  @@index([deletedAt])
  @@schema("catalog")
}

/// Tur içi opsiyonel ekstra (MVP “Ekstralar”). Bağımsız Experience mağazası değil.
model TourExtra {
  id          String    @id @default(cuid())
  tourId      String
  tour        Tour      @relation(fields: [tourId], references: [id], onDelete: Cascade)
  title       String    @db.VarChar(200)
  description String?   @db.Text
  dayNumber   Int?
  price       Decimal   @db.Decimal(10, 2)
  currency    String    @default("TRY") @db.VarChar(3)
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy  String?
  updatedBy  String?
  deletedBy  String?
  deletedAt   DateTime?

  reservationExtras ReservationExtra[]

  @@index([tourId, isActive])
  @@index([sortOrder])
  @@index([deletedAt])
  @@schema("catalog")
}

/// Tur paketindeki konaklama özeti (expand: hotelId/dayNumber; UI legacy alanlar korunur).
model TourAccommodation {
  id          String    @id @default(cuid())
  tourId      String    @unique
  tour        Tour      @relation(fields: [tourId], references: [id], onDelete: Cascade)
  /// Hedef: gün numarası (1…N). Expand default 1.
  dayNumber   Int       @default(1)
  hotelId     String?
  hotel       Hotel?    @relation(fields: [hotelId], references: [id])
  nights      Int       @default(1)
  note        String?   @db.Text
  sortOrder   Int       @default(0)
  /// Legacy UI parity alanları (partner form / detay).
  name        String    @db.VarChar(200)
  image       String
  location    String    @db.VarChar(200)
  type        String    @db.VarChar(80)
  rating      Float     @default(0)
  features    Json      @default("[]")
  description String?   @db.Text
