// ─── outbox ─────────────────────────────────────────────

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED

  @@schema("outbox")
}

model OutboxEvent {
  id            String       @id @default(cuid())
  aggregateType String       @db.VarChar(64)
  aggregateId   String       @db.VarChar(64)
  eventType     String       @db.VarChar(96)
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  lastError     String?      @db.Text
  availableAt   DateTime     @default(now())
  processedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?

  @@index([status, availableAt])
  @@index([aggregateType, aggregateId])
  @@index([eventType, createdAt])
  @@index([deletedAt])
  @@schema("outbox")
}

// ─── promotion ──────────────────────────────────────────

model Coupon {
  id            String    @id @default(cuid())
  code          String    @unique @db.VarChar(40)
  /// PERCENT | FIXED
  discountType  String    @db.VarChar(20)
  discountValue Decimal   @db.Decimal(10, 2)
  startsAt      DateTime?
  endsAt        DateTime?
  maxUses       Int?
  usedCount     Int       @default(0)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdBy  String?
  updatedBy  String?
  deletedBy  String?
  deletedAt     DateTime?

  usages CouponUsage[]

  @@index([isActive, deletedAt])
  @@index([deletedAt])
  @@schema("promotion")
}

model CouponUsage {
  id            String   @id @default(cuid())
  couponId      String
  coupon        Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reservationId String?
  createdAt     DateTime @default(now())

  /// reservationId null iken çoklu validate kaydı mümkün; redeem app katmanında kontrol.
  @@index([couponId, userId])
  @@index([couponId])
  @@index([userId])
  @@schema("promotion")
}

model Campaign {
  id        String    @id @default(cuid())
  title     String    @db.VarChar(200)
  slug      String    @unique @db.VarChar(220)
  bannerUrl String?
  startsAt  DateTime?
  endsAt    DateTime?
  payload   Json?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  createdBy  String?
  updatedBy  String?
  deletedBy  String?
  deletedAt DateTime?

  @@index([isActive, deletedAt])
  @@index([deletedAt])
  @@schema("promotion")
}
