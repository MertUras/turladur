PORT=4000
FRONTEND_URL=http://localhost:3001,http://localhost:3000
NODE_ENV=development

# -----------------------------------------------------------------------------
# DATABASE_URL — ortam ayrımı (Sprint 19)
# -----------------------------------------------------------------------------
# Local Docker (önerilen günlük geliştirme):
DATABASE_URL=postgresql://tourtech:tourtech@localhost:5433/tourtech?schema=public
#
# Neon develop (paylaşılan dev / CI migrate):
# DATABASE_URL="postgresql://USER:PASS@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"
#
# Neon staging (QA / demo):
# DATABASE_URL="postgresql://USER:PASS@ep-xxxx-staging.eu-central-1.aws.neon.tech/neondb?sslmode=require"
#
# Neon production (yalnızca deploy host secret):
# DATABASE_URL="postgresql://USER:PASS@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
#
# Not: prisma migrate deploy → Direct connection
#      Runtime (API/serverless) → Pooled (-pooler) connection tercih et

# -----------------------------------------------------------------------------
# Ortam URL'leri (referans — mobil + web)
# -----------------------------------------------------------------------------
# Local API:     http://localhost:4000
# Local Swagger: http://localhost:4000/api/docs
# Dev API:       https://dev-api.turta.com
# Staging API:   https://staging-api.turta.com
# Production:    https://api.turta.com
#
# CORS FRONTEND_URL örnekleri:
# Local web (legacy):  http://localhost:3000
# Local web (apps):    http://localhost:3001
# Staging web:         https://staging.turta.com
# Production web:      https://turta.com

REDIS_URL=redis://localhost:6379
LOG_LEVEL=info
JWT_SECRET=change-me
JWT_EXPIRES_IN=15m
# Faz 10 — HttpOnly refresh (false = access-only, eski davranış)
AUTH_REFRESH_COOKIE=true
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_COOKIE_NAME=turta_refresh
DEMO_USER_ID=demo-user-id
DEMO_USER_EMAIL=demo@turta.com
DEMO_USER_PASSWORD=Demo1234!
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=tourtech
MINIO_SECRET_KEY=tourtech123
S3_BUCKET=tourtech-media
S3_REGION=eu-central-1
# MinIO: true (default). Cloudflare R2 / AWS S3: false
# S3_FORCE_PATH_STYLE=false
CDN_URL=http://localhost:9000/tourtech-media
# Soft launch (custom domain yok): Nest media proxy — docs/PUBLISH.md
# CDN_URL=https://YOUR-API.up.railway.app/api/v1/storage/media
# API_PUBLIC_URL=https://YOUR-API.up.railway.app
# CORS_ALLOW_VERCEL=true
# Production (Cloudflare R2 custom domain) — docs/CDN_CLOUDFLARE.md
# CDN_URL=https://media.turta.com
# MINIO_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_FORCE_PATH_STYLE=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=learnedfromai@gmail.com
# Google App Password — docs/EMAIL_SETUP.md
SMTP_PASS=
MAIL_FROM="turta <learnedfromai@gmail.com>"
EMAIL_BRAND_URL=https://turladur-zjyf.vercel.app
OTP_SHOW_DEBUG_CODE=false
# Prod: Resend + doğrulanmış domain (SMTP yok)
# RESEND_API_KEY=re_xxxx
# MAIL_FROM="turta <noreply@turta.xyz>"
# Optional — error tracking
SENTRY_DSN=

# -----------------------------------------------------------------------------
# İyzico ödeme (3D Secure)
# -----------------------------------------------------------------------------
# Şirket / vergi no YOKKEN: boş bırak → Mock gateway (…0008 = mock 3DS UI)
# Sandbox (ücretsiz, vergi gerekmez): https://sandbox-merchant.iyzipay.com/auth/register
# Canlı (şirket kurulunca): merchant.iyzipay.com → API Key + Secret Key yapıştır, restart
#
# IYZICO_API_KEY=
# IYZICO_SECRET_KEY=
# IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
# Public URL İyzico'nun 3DS sonrası POST atacağı adres (local: ngrok veya localhost)
# IYZICO_CALLBACK_URL=http://localhost:4000/api/v1/payment/3ds/callback
# API_PUBLIC_URL=http://localhost:4000

# Platform komisyon varsayılanı (%). AgencyCommissionRate yoksa kullanılır.
# PLATFORM_COMMISSION_PERCENT=10

