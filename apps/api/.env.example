PORT=4000
FRONTEND_URL=http://localhost:3001,http://localhost:3000
NODE_ENV=development

# -----------------------------------------------------------------------------
# DATABASE_URL — ortam ayrımı (Sprint 19)
# -----------------------------------------------------------------------------
# Local Docker (önerilen günlük geliştirme):
DATABASE_URL=postgresql://tourtech:tourtech@localhost:5433/tourtech?schema=public
#
# Neon develop (paylaşılan dev / CI migrate):
# DATABASE_URL="postgresql://USER:PASS@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"
#
# Neon staging (QA / demo):
# DATABASE_URL="postgresql://USER:PASS@ep-xxxx-staging.eu-central-1.aws.neon.tech/neondb?sslmode=require"
#
# Neon production (yalnızca deploy host secret):
# DATABASE_URL="postgresql://USER:PASS@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
#
# Not: prisma migrate deploy → Direct connection
#      Runtime (API/serverless) → Pooled (-pooler) connection tercih et

# -----------------------------------------------------------------------------
# Ortam URL'leri (referans — mobil + web)
# -----------------------------------------------------------------------------
# Local API:     http://localhost:4000
# Local Swagger: http://localhost:4000/api/docs
# Dev API:       https://dev-api.turladur.com
# Staging API:   https://staging-api.turladur.com
# Production:    https://api.turladur.com
#
# CORS FRONTEND_URL örnekleri:
# Local web (legacy):  http://localhost:3000
# Local web (apps):    http://localhost:3001
# Staging web:         https://staging.turladur.com
# Production web:      https://turladur.com

REDIS_URL=redis://localhost:6379
LOG_LEVEL=info
JWT_SECRET=change-me
JWT_EXPIRES_IN=15m
DEMO_USER_ID=demo-user-id
DEMO_USER_EMAIL=demo@turladur.com
DEMO_USER_PASSWORD=Demo1234!
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=tourtech
MINIO_SECRET_KEY=tourtech123
S3_BUCKET=tourtech-media
S3_REGION=eu-central-1
CDN_URL=http://localhost:9000/tourtech-media
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=TurlaDur <noreply@turladur.com>
# Optional — error tracking
SENTRY_DSN=
