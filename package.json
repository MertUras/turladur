{
  "name": "tourtech",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "WATCHPACK_POLLING=true WATCHPACK_POLLING_INTERVAL=1000 next dev --hostname localhost",
    "dev:stop": "pkill -f 'next dev --hostname localhost' 2>/dev/null || true; for port in $(seq 3000 3010); do lsof -ti :$port 2>/dev/null | xargs kill -9 2>/dev/null || true; done",
    "dev:clean": "npm run dev:stop && sleep 1 && rm -rf .next && npm run dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "seed": "node prisma/seed.js",
    "db:seed": "prisma db seed",
    "db:refresh-dates": "ts-node prisma/refresh-stale-dates.ts",
    "db:migrate:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate",
    "nx": "nx",
    "graph": "nx graph",
    "dev:web": "pnpm --filter web dev",
    "build:web": "pnpm --filter web build",
    "dev:api": "pnpm --filter api start:dev",
    "build:api": "pnpm --filter api build",
    "dev:apps": "pnpm --parallel --filter web --filter api dev",
    "build:apps": "pnpm nx run-many -t build --projects=web,api,shared-types,shared-validators,shared-constants",
    "docker:up": "docker compose -f infrastructure/docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f infrastructure/docker/docker-compose.yml down",
    "docker:logs": "docker compose -f infrastructure/docker/docker-compose.yml logs -f",
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@headlessui/react": "^2.2.0",
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^4.1.3",
    "@mui/material": "^7.0.2",
    "@prisma/client": "^6.6.0",
    "@radix-ui/react-checkbox": "^1.2.3",
    "@radix-ui/react-dialog": "^1.1.13",
    "@radix-ui/react-label": "^2.1.4",
    "@radix-ui/react-select": "^2.2.4",
    "@radix-ui/react-slot": "^1.2.2",
    "@react-google-maps/api": "^2.20.6",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "@tiptap/extension-image": "^2.14.0",
    "@tiptap/react": "^2.14.0",
    "@tiptap/starter-kit": "^2.14.0",
    "@types/bcrypt": "^5.0.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.9",
    "@uiw/react-md-editor": "^4.0.7",
    "autoprefixer": "^10.4.20",
    "axios": "^1.8.1",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "chart.js": "^4.4.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "focus-trap-react": "^11.0.3",
    "framer-motion": "^12.7.4",
    "jsonwebtoken": "^9.0.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.485.0",
    "next": "^15.2.0",
    "next-auth": "^4.24.7",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.3",
    "postcss": "^8.5.3",
    "react": "^19.1.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.1.0",
    "react-dropzone": "^14.3.8",
    "react-fast-marquee": "^1.6.5",
    "react-hook-form": "^7.54.2",
    "react-hot-toast": "^2.5.2",
    "react-icons": "^5.5.0",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^10.1.0",
    "recharts": "^2.15.3",
    "resend": "^4.4.1",
    "sonner": "^2.0.3",
    "tailwind-merge": "^3.2.0",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4.0.9",
    "@types/leaflet": "^1.9.17",
    "@types/node": "^20.17.30",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19",
    "crypto-browserify": "^3.12.1",
    "eslint": "^9",
    "eslint-config-next": "15.2.0",
    "husky": "^9.1.7",
    "ignore-loader": "^0.1.2",
    "lint-staged": "^17.0.8",
    "@playwright/test": "^1.54.1",
    "nx": "^20.8.0",
    "prettier": "^3.4.2",
    "prisma": "^6.7.0",
    "tailwindcss": "^4.0.9",
    "ts-node": "^10.9.2",
    "typescript": "5.8.2"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
