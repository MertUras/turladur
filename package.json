{
  "name": "tourtech",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm dev:apps",
    "dev:stop": "pkill -f 'next dev' 2>/dev/null || true; pkill -f 'nest start' 2>/dev/null || true; for port in 3000 3001 4000; do lsof -ti :$port 2>/dev/null | xargs kill -9 2>/dev/null || true; done",
    "dev:clean": "pnpm dev:stop && sleep 1 && rm -rf apps/web/.next && pnpm dev",
    "build": "pnpm build:apps",
    "lint": "pnpm nx run-many -t lint --projects=web,api",
    "db:seed": "pnpm --filter api prisma db seed",
    "db:migrate:deploy": "pnpm --filter api prisma migrate deploy",
    "nx": "nx",
    "graph": "nx graph",
    "dev:web": "pnpm --filter web dev",
    "build:web": "pnpm --filter web build",
    "dev:api": "pnpm --filter api start:dev",
    "build:api": "pnpm --filter api build",
    "dev:apps": "pnpm --parallel --filter web --filter api dev",
    "build:apps": "pnpm nx run-many -t build --projects=web,api,shared-types,shared-validators,shared-constants",
    "docker:up": "docker compose -f infrastructure/docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f infrastructure/docker/docker-compose.yml down",
    "docker:logs": "docker compose -f infrastructure/docker/docker-compose.yml logs -f",
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@playwright/test": "^1.54.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "nx": "^20.8.0",
    "prettier": "^3.4.2",
    "typescript": "5.8.2"
  }
}
