generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String               @id @default(cuid())
  name                     String?
  email                    String               @unique
  emailVerified            DateTime?
  password                 String?
  image                    String?
  role                     UserRole             @default(USER)
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  verificationToken        String?
  verificationTokenExpires DateTime?
  status                   String               @default("pending")
  phone                    String?
  activityReviews          ActivityReview[]
  agencies                 Agency[]
  bookings                 Booking[]
  comments                 Comment[]
  experienceOperators      ExperienceOperator[]
  experiences              Experience[]
  hotels                   Hotel[]
  posts                    Post[]
  reviews                  Review[]
  tourOperators            TourOperator[]

  @@map("users")
}

model Hotel {
  id           String    @id @default(cuid())
  name         String
  description  String?
  address      String?
  city         String?
  country      String?
  postalCode   String?
  phone        String?
  email        String?
  website      String?
  stars        Int?
  type         HotelType @default(HOTEL)
  amenities    Json      @default("{}")
  images       Json      @default("[]")
  latitude     Float?
  longitude    Float?
  checkInTime  String?
  checkOutTime String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  userId       String
  bookings     Booking[]
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviews      Review[]
  rooms        Room[]

  @@map("hotels")
}

model Room {
  id          String    @id @default(cuid())
  name        String
  description String?
  type        String?
  capacity    Int
  price       Float
  discount    Float?
  size        Float?
  bedType     String?
  images      Json      @default("[]")
  amenities   Json      @default("{}")
  available   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  hotelId     String
  bookings    Booking[]
  hotel       Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@map("rooms")
}

model Agency {
  id          String    @id @default(cuid())
  name        String
  description String?
  address     String?
  city        String?
  country     String?
  phone       String?
  email       String?
  website     String?
  logo        String?
  license     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  userId      String
  status      String    @default("pending")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings    Booking[]

  @@map("agencies")
}

model TourOperator {
  id          String             @id @default(cuid())
  description String?
  address     String?
  city        String?
  country     String?
  phone       String?
  email       String             @unique
  website     String?
  logo        String?
  license     String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  userId      String
  status      TourOperatorStatus @default(pending)
  companyName String?
  rating      Float?             @default(0)
  certified   Boolean            @default(false)
  bookings    Booking[]
  subUsers    SubUser[]
  user        User               @relation(fields: [userId], references: [id])
  tours       Tour[]

  @@map("tour_operators")
}

model SubUser {
  id             String       @id @default(cuid())
  tourOperatorId String
  name           String
  email          String
  password       String
  role           String       @default("USER")
  permissions    Json
  status         String       @default("ACTIVE")
  lastLoginAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  tourOperator   TourOperator @relation(fields: [tourOperatorId], references: [id])

  @@unique([tourOperatorId, email])
  @@map("sub_users")
}

model TourAccommodation {
  id          String   @id @default(cuid())
  name        String
  image       String
  location    String
  type        String
  rating      Float    @default(0)
  features    Json     @default("[]")
  description String?
  tourId      String   @unique
  tour        Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("tour_accommodations")
}

model Tour {
  id                  String           @id @default(cuid())
  name                String
  description         String?
  duration            Int
  nights              Int?
  price               Float
  discount            Float?
  startDate           DateTime?
  endDate             DateTime?
  maxParticipants     Int?
  destinations        Json            @default("[]")
  inclusions          Json            @default("[]")
  exclusions          Json            @default("[]")
  features            Json            @default("[]")
  itinerary           Json?
  images              Json            @default("[]")
  featured            Boolean         @default(false)
  departureCity       String?
  region              String?
  transportation      String?
  period              String?
  rating              Float?          @default(0)
  tourType            String?
  accommodationType   String?
  difficultyLevel     String?
  ageRestriction     Int?
  isPopular          Boolean         @default(false)
  isLastMinute       Boolean         @default(false)
  isEarlyBird        Boolean         @default(false)
  languages          Json            @default("[]")
  tags               Json            @default("[]")
  meetingPoint       String?
  meetingTime        String?
  meetingPointAddress String?      // Açık adres (buluşma noktası)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  tourOperatorId     String?
  currentParticipants Int?           @default(0)
  availableDates     DateTime[]      @default([])
  bookings           Booking[]
  tourDates          TourDate[]
  pickupPoints       TourPickupPoint[]
  tourOperator       TourOperator?   @relation(fields: [tourOperatorId], references: [id])
  accommodation      TourAccommodation?

  @@map("tours")
}

model TourDate {
  id                  String         @id @default(cuid())
  startDate           DateTime
  endDate             DateTime
  price               Float
  availableSeats      Int
  soldSeats           Int?          @default(0)
  waitingList         Int?          @default(0)
  minParticipants     Int?
  maxParticipants     Int?
  earlyBirdDiscount   Float?
  lastMinuteDiscount  Float?
  earlyBirdDeadline   DateTime?
  lastMinuteStart     DateTime?
  status              String        @default("ACTIVE")
  notes               String?
  isActive            Boolean        @default(true)
  tourId              String
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  tour                Tour           @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@map("tour_dates")
}

model ActivityDate {
  id             String     @id @default(cuid())
  startDate      DateTime
  endDate        DateTime
  price          Float
  availableSeats Int
  activityId     String
  activity       Experience @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@map("activity_dates")
}

model Experience {
  id              String           @id @default(cuid())
  title           String
  description     String
  longDescription String
  imageUrl        String
  gallery         Json             @default("[]")
  location        String
  duration        String
  rating          Float            @default(0)
  reviewCount     Int              @default(0)
  popularityRate  Float            @default(0)
  price           Float
  category        String
  included        Json             @default("[]")
  notIncluded     Json             @default("[]")
  highlights      Json             @default("[]")
  schedule        Json             @default("[]")
  featured        Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  userId          String
  activityDates   ActivityDate[]
  reviews         ActivityReview[]
  bookings        Booking[]
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  generalReviews  Review[]
  meetingPoint    String?          // Google Maps linki (buluşma noktası)
  meetingPointAddress String?      // Açık adres (buluşma noktası)

  @@map("experiences")
}

model ActivityReview {
  id           String     @id @default(cuid())
  rating       Float
  comment      String
  date         DateTime   @default(now())
  userId       String
  experienceId String
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("activity_reviews")
}

model Booking {
  id              String        @id @default(cuid())
  bookingNumber   String        @unique
  startDate       DateTime
  endDate         DateTime
  adults          Int
  children        Int
  totalPrice      Float
  status          BookingStatus @default(PENDING)
  paymentStatus   PaymentStatus @default(UNPAID)
  specialRequests String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  userId          String
  hotelId         String?
  roomId          String?
  tourId          String?
  experienceId    String?
  agencyId        String?
  tourOperatorId  String?
  agency          Agency?       @relation(fields: [agencyId], references: [id])
  experience      Experience?   @relation(fields: [experienceId], references: [id])
  hotel           Hotel?        @relation(fields: [hotelId], references: [id])
  room            Room?         @relation(fields: [roomId], references: [id])
  tour            Tour?         @relation(fields: [tourId], references: [id])
  tourOperator    TourOperator? @relation(fields: [tourOperatorId], references: [id])
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("bookings")
}

model Review {
  id           String      @id @default(cuid())
  rating       Int
  comment      String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  userId       String
  hotelId      String?
  experienceId String?
  experience   Experience? @relation(fields: [experienceId], references: [id])
  hotel        Hotel?      @relation(fields: [hotelId], references: [id])
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model Post {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  content     String
  excerpt     String?
  coverImage  String?
  published   Boolean    @default(false)
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  authorId    String
  comments    Comment[]
  author      User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  categories  Category[] @relation("CategoryToPost")

  @@map("posts")
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  posts       Post[]   @relation("CategoryToPost")

  @@map("categories")
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  authorId  String
  postId    String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("comments")
}

model ExperienceOperator {
  id          String   @id @default(cuid())
  companyName String?
  description String?
  address     String?
  city        String?
  country     String?
  phone       String?
  email       String   @unique
  website     String?
  logo        String?
  license     String?
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String
  user        User     @relation(fields: [userId], references: [id])

  @@map("experience_operators")
}

model TourPickupPoint {
  id          String   @id @default(cuid())
  tourId      String
  city        String
  location    String
  time        String
  description String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  tour        Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@map("tour_pickup_points")
}

enum TourOperatorStatus {
  pending
  approved
  rejected
  suspended
}

enum UserRole {
  USER
  HOTEL_ADMIN
  AGENCY_ADMIN
  TOUR_OPERATOR
  EXPERIENCE_PROVIDER
  ADMIN
}

enum HotelType {
  HOTEL
  BOUTIQUE_HOTEL
  RESORT
  HOSTEL
  APARTMENT
  VILLA
  GUESTHOUSE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  REFUNDED
}

enum TourDateStatus {
  ACTIVE
  FULL
  CANCELLED
  COMPLETED
  WAITING_LIST
  NOT_ENOUGH_PARTICIPANTS
}
