# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# nx
.nx/cache
.nx/workspace-data
/dist
/tmp
packages/*/dist
apps/api/dist
apps/api/src/generated
apps/web/.next
apps/web/out


# testing
/coverage
/test-results
/playwright-report

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# Accidental Finder / sync duplicates ("foo 2", "bar 2.example")
**/* 2/
**/* 2.*

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# pnpm local store (must never live in the repo)
.pnpm-store/

# env files (can opt-in for committing if needed)
.env*
!.env.example
!**/.env.example

# vercel
.vercel

# kullanıcı tarafından yüklenen görseller (örn. aktivite fotoğrafları)
apps/web/public/uploads/

# typescript
*.tsbuildinfo
next-env.d.ts
