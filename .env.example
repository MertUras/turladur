# =============================================================================
# Tourtech / TurlaDur — Ortam Değişkenleri Şablonu
# Kopyala: cp .env.example .env.local
# Gerçek değerleri .env.local içine yazın; bu dosya commit edilir, .env.local edilmez.
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE_URL
# -----------------------------------------------------------------------------
# Yerel Docker PostgreSQL (port 5433 — docker-compose ile):
# DATABASE_URL="postgresql://tourtech:tourtech@localhost:5433/tourtech?schema=public"
#
# Neon — migrate / prisma db push / seed (DIRECT, pooled DEĞİL):
# Neon Console → Connection Details → "Direct connection"
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"
#
# Neon — Vercel runtime (POOLED, serverless için zorunlu):
# Neon Console → Connection Details → "Pooled connection" (PgBouncer)
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL=

# -----------------------------------------------------------------------------
# NextAuth (zorunlu — login / session)
# -----------------------------------------------------------------------------
# Yerel: http://localhost:3000
# Vercel Preview: https://tourtech-git-feat-neon-setup-TEAM.vercel.app
# Vercel Production: https://tourtech.vercel.app (veya custom domain)
NEXTAUTH_URL=http://localhost:3000
# Üret: openssl rand -base64 32
NEXTAUTH_SECRET=

# -----------------------------------------------------------------------------
# Uygulama URL (client-side fetch, e-posta doğrulama linkleri)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Nest apps/web (partner/customer yeni UI) — legacy partner-login buraya yönlenir
NEXT_PUBLIC_APPS_WEB_URL=http://localhost:3001

# -----------------------------------------------------------------------------
# Partner auth (JWT — partner-login API)
# -----------------------------------------------------------------------------
JWT_SECRET=

# -----------------------------------------------------------------------------
# E-posta (opsiyonel — MVP'de atlanabilir)
# -----------------------------------------------------------------------------
# Partner doğrulama e-postası (Resend)
RESEND_API_KEY=
# İletişim formu (SMTP / Nodemailer)
SMTP_USER=
SMTP_PASS=
EMAIL_TO=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false

# -----------------------------------------------------------------------------
# Diğer (opsiyonel)
# -----------------------------------------------------------------------------
BCRYPT_SALT=10
# GOOGLE_MAPS_API_KEY=   # Harita bileşenleri için (şu an kodda placeholder)

# -----------------------------------------------------------------------------
# Firebase (opsiyonel / gelecek — Day 1-2 MVP'de kullanılmıyor)
# -----------------------------------------------------------------------------
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
