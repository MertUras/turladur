## BÖLÜM 1: Yeni NestJS Modülü Oluşturma

### Gereksinimler
- Modül adı (İngilizce, kebab-case): ör. "loyalty", "campaign", "transfer"
- Ana kaynak(lar): ör. "Campaign", "Reward"
- Hangi event'leri yayacak / dinleyecek

### Klasör Yapısı

```
apps/api/src/modules/{module-name}/
├── {module-name}.module.ts
├── controllers/
│   └── {resource}.controller.ts
├── services/
│   └── {resource}.service.ts
├── commands/
│   └── create-{resource}/
│       ├── create-{resource}.command.ts
│       └── create-{resource}.handler.ts
├── queries/
│   └── get-{resource}/
│       ├── get-{resource}.query.ts
│       └── get-{resource}.handler.ts
├── events/
│   └── {resource}-created.event.ts
├── listeners/
├── dto/
│   ├── create-{resource}.dto.ts
│   ├── update-{resource}.dto.ts
│   └── {resource}-response.dto.ts
├── interfaces/
└── __tests__/
    └── {resource}.service.spec.ts
```

### Module Dosyası

```typescript
import { Module } from '@nestjs/common';
import { CqrsModule } from '@nestjs/cqrs';
import { PrismaModule } from '@/core/database/prisma.module';
import { CacheModule } from '@/core/cache/redis.module';

import { {Resource}Controller } from './controllers/{resource}.controller';
import { {Resource}Service } from './services/{resource}.service';
import { Create{Resource}Handler } from './commands/create-{resource}/create-{resource}.handler';
import { Get{Resource}Handler } from './queries/get-{resource}/get-{resource}.handler';

const CommandHandlers = [Create{Resource}Handler];
const QueryHandlers = [Get{Resource}Handler];
const EventListeners = [];

@Module({
  imports: [CqrsModule, PrismaModule, CacheModule],
  controllers: [{Resource}Controller],
  providers: [
    {Resource}Service,
    ...CommandHandlers,
    ...QueryHandlers,
    ...EventListeners,
  ],
})
export class {ModuleName}Module {}
```

### Controller Template

```typescript
import { Controller, Get, Post, Body, Param, Query, UseGuards } from '@nestjs/common';
import { CommandBus, QueryBus } from '@nestjs/cqrs';
import { ApiTags, ApiOperation, ApiResponse, ApiBearerAuth } from '@nestjs/swagger';
import { JwtAuthGuard } from '@/core/auth/guards/jwt-auth.guard';
import { RolesGuard } from '@/core/auth/guards/roles.guard';
import { Roles } from '@/core/auth/decorators/roles.decorator';
import { CurrentUser } from '@/core/auth/decorators/current-user.decorator';
import { Public } from '@/core/auth/decorators/public.decorator';
import { Role } from '@/shared/enums/role.enum';

@Controller('{module-name}/{resource-plural}')
@ApiTags('{ModuleName}')
@ApiBearerAuth()
@UseGuards(JwtAuthGuard, RolesGuard)
export class {Resource}Controller {
  constructor(
    private readonly commandBus: CommandBus,
    private readonly queryBus: QueryBus,
  ) {}

  @Post()
  @Roles(Role.PARTNER, Role.ADMIN)
  @ApiOperation({ summary: 'Create new {resource}' })
  @ApiResponse({ status: 201 })
  async create(@Body() dto: Create{Resource}Dto, @CurrentUser() user: UserPayload) {
    return this.commandBus.execute(new Create{Resource}Command(dto, user.id));
  }

  @Get(':id')
  @Public()
  @ApiOperation({ summary: 'Get {resource} by ID' })
  async getById(@Param('id') id: string) {
    return this.queryBus.execute(new Get{Resource}Query(id));
  }
}
```

### Service Template

```typescript
import { Injectable, NotFoundException } from '@nestjs/common';
import { EventEmitter2 } from '@nestjs/event-emitter';
import { PrismaService } from '@/core/database/prisma.service';
import { CacheService } from '@/core/cache/cache.service';

@Injectable()
export class {Resource}Service {
  constructor(
    private readonly prisma: PrismaService,
    private readonly cache: CacheService,
    private readonly eventEmitter: EventEmitter2,
  ) {}

  async create(dto: Create{Resource}Dto, userId: string) {
    const {resource} = await this.prisma.{resource}.create({
      data: { ...dto, createdById: userId },
    });
    this.eventEmitter.emit('{resource}.created', { {resource}Id: {resource}.id, userId });
    return { success: true, data: {resource}, error: null };
  }

  async findById(id: string) {
    const cacheKey = `{resource}:${id}`;
    const cached = await this.cache.get(cacheKey);
    if (cached) return { success: true, data: cached, error: null };

    const {resource} = await this.prisma.{resource}.findUnique({ where: { id, deletedAt: null } });
    if (!{resource}) throw new NotFoundException('{Resource} not found');

    await this.cache.set(cacheKey, {resource}, 900);
    return { success: true, data: {resource}, error: null };
  }
}
```

### DTO Template

```typescript
import { IsString, IsNotEmpty, MaxLength, IsOptional, IsNumber, Min } from 'class-validator';
import { ApiProperty, ApiPropertyOptional } from '@nestjs/swagger';

export class Create{Resource}Dto {
  @ApiProperty({ maxLength: 200 })
  @IsString()
  @IsNotEmpty()
  @MaxLength(200)
  title: string;

  @ApiPropertyOptional()
  @IsOptional()
  @IsString()
  @MaxLength(2000)
  description?: string;

  @ApiProperty({ minimum: 0 })
  @IsNumber()
  @Min(0)
  price: number;
}
```

### Command + Handler Template

```typescript
// create-{resource}.command.ts
export class Create{Resource}Command {
  constructor(public readonly dto: Create{Resource}Dto, public readonly userId: string) {}
}

// create-{resource}.handler.ts
import { CommandHandler, ICommandHandler } from '@nestjs/cqrs';

@CommandHandler(Create{Resource}Command)
export class Create{Resource}Handler implements ICommandHandler<Create{Resource}Command> {
  constructor(private readonly service: {Resource}Service) {}
  async execute(command: Create{Resource}Command) {
    return this.service.create(command.dto, command.userId);
  }
}
```

### Query + Handler Template

```typescript
// get-{resource}.query.ts
export class Get{Resource}Query {
  constructor(public readonly id: string) {}
}

// get-{resource}.handler.ts
import { QueryHandler, IQueryHandler } from '@nestjs/cqrs';

@QueryHandler(Get{Resource}Query)
export class Get{Resource}Handler implements IQueryHandler<Get{Resource}Query> {
  constructor(private readonly service: {Resource}Service) {}
  async execute(query: Get{Resource}Query) {
    return this.service.findById(query.id);
  }
}
```

### Son Adımlar
1. `app.module.ts`'e modülü import et
2. Prisma schema'ya model ekle (`@@schema("{module-name}")`)
3. `pnpm --filter api prisma migrate dev --name create_{resource}_table`
4. `packages/shared-types/src/{module}.types.ts` oluştur
5. Seed verisi ekle: `apps/api/prisma/seed/{module}.seed.ts`

