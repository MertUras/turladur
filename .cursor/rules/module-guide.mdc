## BÖLÜM 2: End-to-End Feature Geliştirme

### Akış Sırası

```
1. Backend DTO → 2. Command/Query → 3. Service → 4. Controller
5. Shared Types → 6. Shared Validators (Zod)
7. Frontend Service → 8. Page → 9. Component → 10. Form (varsa)
```

### Frontend Sayfa Yönlendirme

| Kullanıcı Tipi | Route Group | Örnek Yol |
|---|---|---|
| Herkes (SEO) | `(marketing)/` | `/tours`, `/hotels`, `/activities` |
| Giriş yapmış müşteri | `(customer)/` | `/bookings`, `/profile`, `/checkout` |
| Partner | `(partner)/` | `/partner/dashboard`, `/partner/tours` |
| Admin | `(admin)/` | `/admin/dashboard`, `/admin/users` |
| Auth sayfaları | `(auth)/` | `/login`, `/register` |

### Frontend Service Template

```typescript
// apps/web/src/services/{module}.service.ts
import { apiClient } from './api-client';
import type { Tour, TourSearchResponse } from '@turladur/shared-types';

export const catalogService = {
  searchTours: (params: Record<string, unknown>) =>
    apiClient.get<ApiResponse<TourSearchResponse>>('/catalog/tours/search', { params }),
  getTourById: (id: string) =>
    apiClient.get<ApiResponse<Tour>>(`/catalog/tours/${id}`),
};
```

### Frontend Page (Public/SEO)

```typescript
// apps/web/src/app/(marketing)/tours/page.tsx
import type { Metadata } from 'next';

export const metadata: Metadata = {
  title: 'Tur Ara | TurlaDur',
  description: "Türkiye'nin en güzel turlarını keşfedin.",
};

export default async function ToursPage({ searchParams }: { searchParams: Promise<Record<string, string>> }) {
  const params = await searchParams;
  const res = await fetch(`${process.env.API_URL}/api/v1/catalog/tours/search?${new URLSearchParams(params)}`, {
    next: { revalidate: 300 },
  });
  const data = await res.json();
  return <TourSearchPage initialData={data.data} />;
}
```

### Frontend Page (Protected)

```typescript
// apps/web/src/app/(customer)/bookings/page.tsx
'use client';
import { useQuery } from '@tanstack/react-query';
import { bookingService } from '@/services/booking.service';

export default function BookingsPage() {
  const { data, isLoading } = useQuery({
    queryKey: ['bookings', 'my'],
    queryFn: () => bookingService.getMyBookings(),
  });
  if (isLoading) return <LoadingSpinner />;
  return <BookingList bookings={data.data} />;
}
```

### Frontend Form (React Hook Form + Zod)

```typescript
'use client';
import { useForm } from 'react-hook-form';
import { zodResolver } from '@hookform/resolvers/zod';
import { createBookingSchema, type CreateBookingInput } from '@turladur/shared-validators';

export function BookingForm({ tourDateId }: { tourDateId: string }) {
  const form = useForm<CreateBookingInput>({
    resolver: zodResolver(createBookingSchema),
    defaultValues: { tourDateId },
  });

  const mutation = useMutation({
    mutationFn: bookingService.createBooking,
    onSuccess: () => toast.success('Rezervasyon oluşturuldu!'),
    onError: (err) => toast.error(err.message),
  });

  return (
    <form onSubmit={form.handleSubmit((data) => mutation.mutate(data))}>
      {/* form fields */}
    </form>
  );
}
```

