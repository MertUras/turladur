## 7. Search (Arama)

### Strateji

| Aşama | Teknoloji | Ne Zaman |
|-------|-----------|----------|
| Başlangıç | PostgreSQL `ILIKE` + `tsvector` | 0-100K kayıt |
| Büyüme | Redis cached search + PostgreSQL | 100K-1M kayıt |
| Ölçek | Elasticsearch / Meilisearch | 1M+ kayıt |

### PostgreSQL Full-Text Search (Başlangıç)

```prisma
model Tour {
  // ...
  searchVector Unsupported("tsvector")?

  @@index([searchVector], type: Gin)
  @@schema("catalog")
}
```

```sql
-- Migration'da
ALTER TABLE catalog."Tour" 
ADD COLUMN "searchVector" tsvector 
GENERATED ALWAYS AS (
  setweight(to_tsvector('turkish', coalesce(title, '')), 'A') ||
  setweight(to_tsvector('turkish', coalesce(description, '')), 'B')
) STORED;

CREATE INDEX idx_tour_search ON catalog."Tour" USING GIN("searchVector");
```

### Search Service

```typescript
@Injectable()
export class SearchService {
  constructor(
    private readonly prisma: PrismaService,
    private readonly cache: CacheService,
  ) {}

  async searchTours(query: string, filters: SearchFilters) {
    const cacheKey = `catalog:tours:search:${this.hashParams(query, filters)}`;
    const cached = await this.cache.get(cacheKey);
    if (cached) return cached;

    const results = await this.prisma.$queryRaw(Prisma.sql`
      SELECT id, title, slug, price, "coverImage", 
             ts_rank("searchVector", plainto_tsquery('turkish', ${query})) as rank
      FROM catalog."Tour"
      WHERE "searchVector" @@ plainto_tsquery('turkish', ${query})
        AND "deletedAt" IS NULL
        AND status = 'ACTIVE'
      ORDER BY rank DESC
      LIMIT ${filters.limit} OFFSET ${(filters.page - 1) * filters.limit}
    `);

    await this.cache.set(cacheKey, results, 300);
    return results;
  }
}
```

