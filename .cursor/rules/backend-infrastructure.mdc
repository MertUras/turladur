## 8. Error Handling (Global)

### Exception Filter

```typescript
// apps/api/src/core/filters/global-exception.filter.ts
import { ExceptionFilter, Catch, ArgumentsHost, HttpException, HttpStatus } from '@nestjs/common';

@Catch()
export class GlobalExceptionFilter implements ExceptionFilter {
  private readonly logger = new Logger('ExceptionFilter');

  catch(exception: unknown, host: ArgumentsHost) {
    const ctx = host.switchToHttp();
    const response = ctx.getResponse();

    let status = HttpStatus.INTERNAL_SERVER_ERROR;
    let code = 'INTERNAL_ERROR';
    let message = 'Bir sorun oluştu, lütfen tekrar deneyin.';

    if (exception instanceof HttpException) {
      status = exception.getStatus();
      const res = exception.getResponse() as { code?: string; message?: string };
      code = res.code || `HTTP_${status}`;
      message = res.message || exception.message;
    }

    if (exception instanceof BusinessException) {
      status = exception.statusCode;
      code = exception.code;
      message = exception.message;
    }

    // 5xx → logla (production'da kullanıcıya detay verme)
    if (status >= 500) {
      this.logger.error(`${code}: ${message}`, (exception as Error).stack);
      message = 'Bir sorun oluştu, lütfen tekrar deneyin.';
    }

    response.status(status).json({
      success: false,
      data: null,
      error: { code, message },
    });
  }
}
```

### Custom Business Exceptions

```typescript
// apps/api/src/shared/exceptions/business.exception.ts
export class BusinessException extends Error {
  constructor(
    public readonly code: string,
    public readonly message: string,
    public readonly statusCode: number = 422,
  ) { super(message); }
}

// Kullanım örnekleri
export class TourNotAvailableException extends BusinessException {
  constructor() { super('BOOKING_TOUR_NOT_AVAILABLE', 'Seçilen tarihte müsaitlik bulunmamaktadır.', 422); }
}

export class InsufficientBalanceException extends BusinessException {
  constructor() { super('PAYMENT_INSUFFICIENT_BALANCE', 'Yetersiz bakiye.', 422); }
}

export class PartnerNotVerifiedException extends BusinessException {
  constructor() { super('PARTNER_NOT_VERIFIED', 'Hesabınız henüz doğrulanmamış.', 403); }
}
```

