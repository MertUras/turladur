{
  "name": "shared-constants",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/shared-constants/src",
  "projectType": "library",
  "tags": ["scope:shared", "type:constants"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "pnpm --filter @turladur/shared-constants build",
        "cwd": "{workspaceRoot}"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --filter @turladur/shared-constants lint",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
